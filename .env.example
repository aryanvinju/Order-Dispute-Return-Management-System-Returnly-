# Existing local servers: use port 3306 and your own database user/password.
# Docker databases: use the defaults below.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=returnly
MYSQL_PASSWORD=returnly_local_only
MYSQL_DATABASE=returnly
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=returnly
APP_URL=http://127.0.0.1:3000
# Set true behind HTTPS in deployment.
SESSION_SECURE=false
# Used only by seed; change it before sharing a deployment.
DEMO_PASSWORD=DemoPass123!
